# Copy to .env and fill locally. Never commit .env.
# Mock-first: all automated QA runs offline, zero AWS spend.
GENIE_MODE=mock
# Strands model id (Bedrock default). Only needed for live agent runs.
STRANDS_MODEL_ID=
# AWS creds required ONLY for live Bedrock / AgentCore runs (stretch).
AWS_REGION=ap-southeast-3
API_PORT=8002
LOG_LEVEL=info
